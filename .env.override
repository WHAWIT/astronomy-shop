# Whawit demo environment (non-secret). WHAWIT_API_KEY is injected at boot by
# whawit/vm/startup.sh from GCP Secret Manager and must never be written here.
WHAWIT_OTLP_ENDPOINT=https://sandbox.services.whawit.ai/ingest/otlp
WHAWIT_PROJECT_ID=urn:project:astronomy-shop
WHAWIT_RECORDINGS_DIR=./recordings
